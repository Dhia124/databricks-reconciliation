# Copier en .env puis renseigner.

# simulation | databricks
MODE_EXECUTION=simulation

# Dossier du workspace où sont importés les notebooks 00 à 04
DATABRICKS_NOTEBOOK_PREFIX=/Workspace/Users/prenom.nom@exemple.fr/reconciliation

# Laisser vide pour un cluster éphémère créé à chaque run.
# Renseigner l'id d'un cluster existant (Free Edition : celui de votre workspace) pour réutiliser.
DATABRICKS_CLUSTER_ID=
